[run]
branch = True
# The package is the code. The four .py files at the root are launchers that do
# nothing but delegate into it; tests/test_layout.py proves they still resolve,
# which is the only thing about them that can break.
source =
    receiptmaker
omit =
    tests/*
    build/*
    dist/*

[report]
# Show which lines are missed, and fail the run below the agreed floor.
show_missing = True
skip_covered = False
precision = 1
fail_under = 80
exclude_lines =
    pragma: no cover
    # Defensive branches that only fire on a broken environment.
    if __name__ == .__main__.:
    raise AssertionError
    except ImportError
