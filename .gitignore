*.bak
*.log

# Runtime marker written when Templates/ is seeded beside the executable.
# Holds the hashes recorded at copy time; it is per-install state, not source.
Templates/.installed.json

# The pinned gate fixture lives in a directory named "env", which the generic
# virtualenv rules above (env/, ENV/) match -- so without this negation it would
# never be committed, and a fresh clone would have no config for the golden gate
# to render against. Negations must come after the rule they undo.
!tests/fixtures/env/
!tests/fixtures/env/*

# ...but the parts of it that are generated at runtime stay untracked. These
# must follow the negation above to win: the Templates/ copy seeded on first
# use, the .bak files migration leaves behind, and the invoices/ folder the
# counter is written into.
tests/fixtures/env/Templates/
tests/fixtures/env/invoices/
tests/fixtures/env/*.bak

# Remembered machine state (sticky values). Per-install, not source.
state.json
tests/fixtures/env/state.json

# Receipt history: the record of what was generated, kept out of the browsable
# receipts folder.
invoices/.archive/

# The product catalogue is the user's own data, not source.
products.json
tests/fixtures/env/products.json

# Coverage output
htmlcov/
.coverage
